{
    "name": "brutebank/laravel-filament",
    "description": "BruteBank firewall and two-factor security integration for Laravel and Filament.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/auth": "^13.0",
        "illuminate/mail": "^13.0",
        "filament/filament": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "BruteBank\\LaravelFilament\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BruteBank\\LaravelFilament\\BruteBankServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
