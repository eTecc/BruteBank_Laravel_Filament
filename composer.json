{
    "name": "brutebank/laravel-filament",
    "description": "BruteBank firewall and two-factor security integration for Laravel and Filament.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.45|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.45|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.45|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.45|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.45|^11.0|^12.0|^13.0",
        "illuminate/auth": "^10.45|^11.0|^12.0|^13.0",
        "illuminate/mail": "^10.45|^11.0|^12.0|^13.0",
        "filament/filament": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "BruteBank\\LaravelFilament\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BruteBank\\LaravelFilament\\BruteBankServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
